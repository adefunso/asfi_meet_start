<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | ASFIMeet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/assets/favicon_inverted.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: 'purple',
                        danger: 'rgb(239, 32, 32)',
                        success: 'teal',
                        accent: 'rgb(255, 111, 0)',
                        'bg-dark': 'rgb(34, 34, 34)',
                    }
                }
            }
        }
    </script>
    <style>
        .msg {
            transition: all 0.3s ease-in-out;
        }

        .hidden {
            display: none;
        }

        .btn-loading {
            position: relative;
            pointer-events: none;
            opacity: 0.7;
        }

        .btn-loading .btn-text {
            visibility: hidden;
        }

        .btn-loading .btn-spinner {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-spinner {
            display: none;
        }

        .btn-spinner i {
            font-size: 20px;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .g-recaptcha {
            display: flex;
            justify-content: center;
        }
    </style>
</head>
<body class="bg-bg-dark min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-transparent rounded-lg shadow-[0px_40px_30px_0px_rgba(0,0,0,0.25)] p-6">
        <div class="flex flex-col items-center space-y-4">
            <a href="/home">
                <img src="/assets/logo_inverted.png" class="w-[150px]" alt="ASFIMeet Logo">
            </a>
            
            <h2 class="text-white text-xl font-bold mt-2">Sign In to ASFIMeet</h2>
       
            
            <form id="loginForm" class="w-full space-y-4 mt-2">
                <div class="space-y-1">
                    <label for="email" class="text-white block text-sm">Email / Username</label>
                    <input type="text" id="user" name="email" required 
                        class="w-full bg-transparent border-b border-gray-300 py-1 px-2 text-white focus:outline-none focus:border-primary">
                </div>
                
                <div class="space-y-1">
                    <label for="password" class="text-white block text-sm">Password</label>
                    <input type="password" id="pass" name="password" required 
                        class="w-full bg-transparent border-b border-gray-300 py-1 px-2 text-white focus:outline-none focus:border-primary">
                        <i class="fa fa-eye block text-accent user-select-none text-sm  cursor-pointer" style="user-select: none;" onclick="show_pass()">show password</i>
                </div>
                
        
                <div class="g-recaptcha" data-sitekey="6LdJ9tstAAAAAPDuyxH2E-HbSLFHRiatdy7hr4ln" data-callback="onLoginRecaptcha" data-expired-callback="onLoginRecaptchaExpired"></div>
               

                <div class="space-y-3 mt-2">
                    <button type="submit" id="loginBtn"
                        <%= "6LdJ9tstAAAAAPDuyxH2E-HbSLFHRiatdy7hr4ln" ? 'disabled' : '' %>
                        class="w-full bg-primary text-white py-2 px-4 rounded-[25px] text-base font-medium hover:bg-opacity-90 transition disabled:opacity-60 disabled:cursor-not-allowed">
                        <span class="btn-text">Sign In</span>
                        <span class="btn-spinner"><i class="fas fa-spinner"></i></span>
                    </button>
                    
                    <% if(meetingId && meetingId !== ""){ %>
                    <p class="text-white text-center text-sm">Or</p>
                    <button type="button" onclick="window.location.href='/join/<%=meetingId %>?byPass=true'" 
                        class="w-full border border-white text-white bg-transparent py-2 px-4 rounded-[25px] text-base font-medium hover:bg-primary hover:border-primary hover:text-white transition">
                        Continue Without an account
                    </button>
                    <% } %>
                    
                    <p class="text-white text-center text-sm mt-2">
                        Don't have an account? <a href="https://asfischolar.org/register/" class="text-accent hover:underline">Sign Up</a>
                    </p>
                    
                    <a href="https://asfischolar.org/passwordReset" class="block text-accent text-center text-sm hover:underline">
                        Forgot password
                    </a>
                </div>
            </form>
        </div>
    </div>
      <link rel="stylesheet" href="/assets/global/css/iziToast.min.css">
  <script src="/assets/global/js/iziToast.min.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="/js/login.js"></script>
</body>
</html>