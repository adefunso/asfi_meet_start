<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ASFIMeet | Poster Management Dashboard</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="ASFIMeet is a secure and high-quality video conferencing platform from ASFI. Host meetings, collaborate, and connect with teams effortlessly.">
  <meta name="keywords" content="video conferencing, online meetings, virtual meetings, remote work, team collaboration">
  <meta name="author" content="Weperch Technologies Limited">

  <!-- Open Graph (For Social Media Sharing) -->
  <meta property="og:title" content="ASFIMeet - Seamless Video Conferencing">
  <meta property="og:description" content="Host secure and high-quality video meetings with ASFIMeet. Collaborate with your team anytime, anywhere.">
  <meta property="og:image" content="https://res.cloudinary.com/diml8ljwa/image/upload/c_thumb,w_200,g_face/v1743261283/Screenshot_147_mjjyce.png">
  <meta property="og:url" content="https://asfischolar.net">
  <meta property="og:type" content="website">

  <!-- Twitter Card (For Twitter Sharing) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="ASFIMeet - Seamless Video Conferencing">
  <meta name="twitter:description" content="Experience high-quality, secure video meetings with ASFIMeet. Connect, collaborate, and stay productive.">
  <meta name="twitter:image" content="https://res.cloudinary.com/diml8ljwa/image/upload/c_thumb,w_200,g_face/v1743261283/Screenshot_147_mjjyce.png">

  <!-- Favicon -->
  <link rel="icon" href="/assets/favicon_inverted.png" type="image/x-icon">

  <!-- Canonical URL -->
  <link rel="canonical" href="https://asfischolar.net">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      display: flex;
      font-family:sans-serif;
      background-color: #222;
      font-size: 15px;
    }
    h1,h2{
      font-size: 18px;
    }
    .sidebar {
      background-color: rgba(15, 15, 15);
      color: white;
      width: 250px;
      height: 100vh;
      padding: 20px;
      position: fixed;
      left: 0;
      top: 0;
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.show {
      transform: translateX(0);
    }
    .sidebar h2 {
      text-align: center;
      font-size: 15px;
    }
    .sidebar ul {
      list-style: none;
      padding: 0;
    }
    .sidebar ul li {
      margin: 20px 0;
    }
    .sidebar ul li a {
      color: #ddd;
      text-decoration: none;
      font-size: 15px;
      display: block;
      padding: 10px;
      transition: background-color 0.3s;
    }
    .sidebar ul li a:hover {
      background-color: #4b345e;
    }
    .menu-icon {
      display: none;
      font-size: 18px;
      cursor: pointer;
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 1001;
      transition: transform 0.3s ease-in-out;
    }
    .menu-icon.slide {
      transform: translateX(600%);
    }
    .main-content {
      margin-left: 270px;
      padding: 20px;
      width: 100%;
      transition: margin-left 0.3s;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .header-sub {
      margin-top: 6px;
      font-size: 13px;
      color: #b9b9c3;
    }
    .ghost-btn {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #555;
      color: #eee;
      text-decoration: none;
      font-size: 13px;
    }
    .ghost-btn:hover {
      background-color: #444;
    }

    /* Overview stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 16px;
      margin-top: 20px;
    }
    .stat-card {
      background-color: #333;
      color: white;
      border-radius: 12px;
      padding: 18px;
      border: 1px solid #3f3f46;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .stat-card .stat-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #a9a9b3;
    }
    .stat-card .stat-value {
      display: block;
      margin-top: 10px;
      font-size: 26px;
      font-weight: 700;
      color: #fff;
    }
    .stat-card .stat-meta {
      display: block;
      margin-top: 6px;
      font-size: 12px;
      color: #9aa0a6;
    }
    .stat-card--accent {
      background: linear-gradient(150deg, #3c2a55 0%, #2b2138 100%);
      border-color: #5c427c;
    }

    .alert {
      margin-top: 20px;
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 14px;
    }
    .alert--error {
      background: #3b1f22;
      color: #f8b4b4;
      border: 1px solid #6b2b31;
    }
    .alert--success {
      background: #1e3324;
      color: #b7f0c4;
      border: 1px solid #2f5c3c;
    }
    .row-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .assign-form {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .assign-form select {
      max-width: 170px;
      padding: 7px 8px;
      border-radius: 8px;
      border: 1px solid #555;
      background-color: #262626;
      color: #f2f2f2;
      font-size: 12px;
    }
    .mini-btn {
      border: 1px solid #555;
      background-color: #2f2f35;
      color: #eee;
      padding: 7px 10px;
      border-radius: 8px;
      font-size: 12px;
      cursor: pointer;
    }
    .mini-btn:hover {
      background-color: #3d3d45;
    }
    .mini-btn--danger {
      border-color: #6b2b31;
      background-color: #3b1f22;
      color: #f8b4b4;
    }
    .mini-btn--danger:hover {
      background-color: #4d262b;
    }

    .poster-lists {
      margin-top: 20px;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .section-head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 10px;
    }
    .filters label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 12px;
      color: #b9b9c3;
    }
    .filters select {
      min-width: 190px;
      padding: 9px 10px;
      border-radius: 8px;
      border: 1px solid #555;
      background-color: #262626;
      color: #f2f2f2;
      font-size: 13px;
    }
    .apply-btn {
      padding: 9px 16px;
      border: none;
      border-radius: 8px;
      background-color: purple;
      color: white;
      font-size: 13px;
      cursor: pointer;
    }
    .reset-link {
      padding: 9px 4px;
      color: #cfcfd6;
      font-size: 13px;
      text-decoration: underline;
    }

    .poster-grid{
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead td {
      font-weight: bold;
      background: #141414;
      padding: 12px 10px;
      color: rgb(190, 190, 190);
      font-size: 13px;
      text-align: left;
      white-space: nowrap;
    }
    tbody td {
      padding: 14px 10px;
      border-bottom: 1px solid #4a4a4a;
      font-size: 14px;
      vertical-align: middle;
    }
    tbody tr:hover {
      background-color: #3a3a3a;
    }
    .poster-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 220px;
    }
    .poster-title {
      font-weight: 600;
    }
    .poster-id {
      font-size: 11px;
      color: #9aa0a6;
    }
    .muted {
      color: #9aa0a6;
    }
    .empty {
      text-align: center;
      color: #b9b9c3;
      padding: 32px 10px !important;
    }
    .view-poster-btn {
      display: inline-block;
      width: 120px;
      border: none;
      text-decoration: none;
      background-color: purple;
      color: white;
      padding: 9px;
      border-radius: 8px;
      font-size: 13px;
      cursor: pointer;
    }
    .view-poster-btn:hover {
      background-color: #6b1f8f;
    }

    .pagination {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
    }
    .page-info {
      font-size: 13px;
      color: #b9b9c3;
    }
    .page-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }
    .page-links a,
    .page-links span.page-number {
      min-width: 34px;
      text-align: center;
      padding: 7px 10px;
      border-radius: 8px;
      border: 1px solid #4a4a4a;
      color: #e7e7ea;
      text-decoration: none;
      font-size: 13px;
    }
    .page-links a:hover {
      background-color: #444;
    }
    .page-links .is-current {
      background-color: purple;
      border-color: purple;
      color: #fff;
      font-weight: 600;
    }
    .page-links .is-disabled {
      color: #6b6b73;
      border-color: #3a3a3a;
    }
    .page-links .ellipsis {
      border: none;
      color: #9aa0a6;
    }

    /* Poster preview popup */
    .poster-modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .poster-modal.is-open {
      display: flex;
    }
    .poster-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
    }
    .poster-modal__panel {
      position: relative;
      display: flex;
      flex-direction: column;
      width: min(1100px, 96vw);
      height: min(88vh, 900px);
      background: #1b1b1f;
      border: 1px solid #3f3f46;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    }
    .poster-modal__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      background: #26262b;
      color: #f1f1f3;
      border-bottom: 1px solid #3f3f46;
    }
    .poster-modal__head strong {
      font-size: 14px;
      font-weight: 600;
    }
    .poster-modal__controls {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .poster-modal__controls a {
      color: #c9b3e6;
      font-size: 12px;
    }
    .poster-modal__close {
      border: none;
      background: transparent;
      color: #ddd;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      padding: 0 4px;
    }
    .poster-modal__close:hover {
      color: #fff;
    }
    #poster-modal-frame {
      flex: 1;
      width: 100%;
      border: none;
      background: #fff;
    }
    body.poster-modal-open {
      overflow: hidden;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .menu-icon {
        display: block;
        font-size: 25px;
        background: purple;
        color: white;
        padding: 6px;
        border-radius: 8px;
      }
      .main-content {
        margin-left: 0;
        margin-top: 70px;
      }
      .filters select {
        min-width: 140px;
      }
      .poster-modal {
        padding: 0;
      }
      .poster-modal__panel {
        width: 100vw;
        height: 100vh;
        border-radius: 0;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/dashboardSidebar.ejs', { sidebarRole: "admin" }) %>

  <div class="main-content">
    <header>
      <div>
        <h1>Dashboard Overview</h1>
        <p class="header-sub">Every poster submitted across all meetings</p>
      </div>
      <a href="/manageposters" class="ghost-btn">Refresh</a>
    </header>

    <!-- Overview stats -->
    <section class="stats-grid">
      <div class="stat-card stat-card--accent">
        <span class="stat-label">Total Posters</span>
        <span class="stat-value"><%= Number(stats.totalPosters).toLocaleString() %></span>
        <span class="stat-meta"><%= Number(stats.totalMeetings).toLocaleString() %> meeting(s)</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Total Ratings</span>
        <span class="stat-value"><%= Number(stats.totalRatings).toLocaleString() %></span>
        <span class="stat-meta">Average <%= Number(stats.averageRating).toFixed(1) %></span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Total Views</span>
        <span class="stat-value"><%= Number(stats.totalViews).toLocaleString() %></span>
        <span class="stat-meta">All posters</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Total Likes</span>
        <span class="stat-value"><%= Number(stats.totalLikes).toLocaleString() %></span>
        <span class="stat-meta">From reactions</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Total Dislikes</span>
        <span class="stat-value"><%= Number(stats.totalDislikes).toLocaleString() %></span>
        <span class="stat-meta">From reactions</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Total Downloads</span>
        <span class="stat-value"><%= Number(stats.totalDownloads).toLocaleString() %></span>
        <span class="stat-meta">All posters</span>
      </div>
    </section>

    <% if (notice) { %>
      <div class="alert alert--<%= notice.kind %>"><%= notice.text %></div>
    <% } %>

    <% if (loadError) { %>
      <div class="alert alert--error"><%= loadError %></div>
    <% } %>

    <!-- Poster list -->
    <section class="poster-lists" id="poster-lists">
      <div class="section-head">
        <h2>All Posters</h2>

        <form id="poster-filters" class="filters" method="GET" action="/manageposters">
          <label>
            Meeting
            <select name="meeting">
              <option value="">All meetings</option>
              <% meetings.forEach(function (meeting) { %>
                <option value="<%= meeting.meeting %>" <%= filters.meeting === meeting.meeting ? "selected" : "" %>><%= meeting.name %> (<%= meeting.total %>)</option>
              <% }); %>
            </select>
          </label>

          <label>
            Sort by
            <select name="sort">
              <option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest first</option>
              <option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest first</option>
              <option value="title" <%= filters.sort === "title" ? "selected" : "" %>>Title (A–Z)</option>
              <option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Highest rated</option>
              <option value="views" <%= filters.sort === "views" ? "selected" : "" %>>Most viewed</option>
              <option value="likes" <%= filters.sort === "likes" ? "selected" : "" %>>Most liked</option>
            </select>
          </label>

          <!-- Changing a filter resets to page 1 -->
          <input type="hidden" name="page" value="1">

          <button type="submit" class="apply-btn">Apply</button>
          <a href="/manageposters" class="reset-link">Reset</a>
        </form>
      </div>

      <div class="poster-grid">
        <table>
          <thead>
            <tr>
              <td>Poster</td>
              <td>Presenter</td>
              <td>Meeting</td>
              <td>Rating</td>
              <td>Views</td>
              <td>Likes</td>
              <td>Submitted</td>
              <td>Actions</td>
            </tr>
          </thead>

          <tbody id="poster-list">
            <% if (posters.length === 0) { %>
              <tr>
                <td colspan="8" class="empty">
                  <%= filters.meeting ? "No posters for this meeting yet." : "No posters have been submitted yet." %>
                </td>
              </tr>
            <% } %>

            <% posters.forEach(function (poster) { %>
              <tr>
                <td>
                  <div class="poster-cell">
                    <span class="poster-title"><%= poster.poster_deck_title %></span>
                    <span class="poster-id"><%= poster.poster_deck_id %></span>
                  </div>
                </td>
                <td><%= poster.poster_deck_owner %></td>
                <td><%= poster.meeting_name %></td>
                <td>
                  <%= Number(poster.total_rating).toFixed(1) %>
                  <span class="muted">(<%= poster.rating_count %>)</span>
                </td>
                <td><%= Number(poster.view_count).toLocaleString() %></td>
                <td><%= Number(poster.like_count).toLocaleString() %></td>
                <td><%= poster.dateLabel %></td>
                <td>
                  <div class="row-actions">
                    <button
                      type="button"
                      class="view-poster-btn"
                      data-view-poster
                      data-poster-id="<%= poster.poster_deck_id %>"
                      data-poster-title="<%= poster.poster_deck_title %>">View Poster</button>

                    <form method="POST" action="/manageposters/assign-meeting" class="assign-form">
                      <input type="hidden" name="poster_id" value="<%= poster.poster_deck_id %>">
                      <input type="hidden" name="return_to" value="<%= returnTo %>">
                      <select name="meeting" aria-label="Move <%= poster.poster_deck_title %> to another meeting" required>
                        <option value="">Move to…</option>
                        <% meetings.forEach(function (option) { %>
                          <option value="<%= option.meeting %>"><%= option.name %></option>
                        <% }); %>
                      </select>
                      <button type="submit" class="mini-btn">Assign</button>
                    </form>

                    <form method="POST" action="/manageposters/delete" onsubmit="return confirm('Delete this poster and its ratings and reactions? This cannot be undone.');">
                      <input type="hidden" name="poster_id" value="<%= poster.poster_deck_id %>">
                      <input type="hidden" name="return_to" value="<%= returnTo %>">
                      <button type="submit" class="mini-btn mini-btn--danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% const rangeStart = pagination.total === 0 ? 0 : ((pagination.page - 1) * pagination.limit) + 1; %>
      <% const rangeEnd = Math.min(pagination.page * pagination.limit, pagination.total); %>
      <% const baseQuery = (filters.meeting ? "meeting=" + encodeURIComponent(filters.meeting) + "&" : "") + "sort=" + encodeURIComponent(filters.sort) + "&page="; %>

      <div class="pagination">
        <span class="page-info">
          Showing <%= rangeStart %>–<%= rangeEnd %> of <%= Number(pagination.total).toLocaleString() %> poster(s)
        </span>

        <div class="page-links">
          <% if (pagination.hasPrevious) { %>
            <a href="/manageposters?<%= baseQuery %><%= pagination.page - 1 %>" rel="prev">Previous</a>
          <% } else { %>
            <span class="page-number is-disabled">Previous</span>
          <% } %>

          <% pageLinks.forEach(function (link) { %>
            <% if (link === "…") { %>
              <span class="page-number ellipsis">…</span>
            <% } else if (link === pagination.page) { %>
              <span class="page-number is-current"><%= link %></span>
            <% } else { %>
              <a href="/manageposters?<%= baseQuery %><%= link %>"><%= link %></a>
            <% } %>
          <% }); %>

          <% if (pagination.hasNext) { %>
            <a href="/manageposters?<%= baseQuery %><%= pagination.page + 1 %>" rel="next">Next</a>
          <% } else { %>
            <span class="page-number is-disabled">Next</span>
          <% } %>
        </div>
      </div>
    </section>
  </div>

  <!-- Poster preview popup -->
  <div class="poster-modal" id="poster-modal" aria-hidden="true">
    <div class="poster-modal__backdrop" data-close-modal></div>
    <div class="poster-modal__panel" role="dialog" aria-modal="true" aria-labelledby="poster-modal-title">
      <div class="poster-modal__head">
        <strong id="poster-modal-title">Poster preview</strong>
        <div class="poster-modal__controls">
          <a id="poster-modal-external" href="#" target="_blank" rel="noopener noreferrer">Open in new tab</a>
          <button type="button" class="poster-modal__close" data-close-modal aria-label="Close poster preview">×</button>
        </div>
      </div>
      <iframe id="poster-modal-frame" src="about:blank" title="Poster preview" allow="camera; microphone; screen-wake-lock; display-capture; fullscreen; autoplay; clipboard-write"></iframe>
    </div>
  </div>

  <script>
    function toggleSidebar() {
      document.getElementById("sidebar").classList.toggle("show");
      document.getElementById("menu-icon").classList.toggle("slide");
    }
  </script>
  <script>
    window.POSTERS_BASE = "<%= postersBase %>";
  </script>
  <script src="/js/manageposters.js"></script>

</body>
</html>
