<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ASFIMeet | Posters Leader boards</title>

  <!-- SEO Meta Tags -->
  <meta name="description" content="ASFIMeet is a secure and high-quality video conferencing platform from ASFI. Host meetings, collaborate, and connect with teams effortlessly.">
  <meta name="keywords" content="video conferencing, online meetings, virtual meetings, remote work, team collaboration">
  <meta name="author" content="Weperch Technologies Limited">

  <!-- Open Graph (For Social Media Sharing) -->
  <meta property="og:title" content="ASFIMeet - Seamless Video Conferencing">
  <meta property="og:description" content="Host secure and high-quality video meetings with ASFIMeet. Collaborate with your team anytime, anywhere.">
  <meta property="og:image" content="https://res.cloudinary.com/diml8ljwa/image/upload/c_thumb,w_200,g_face/v1743261283/Screenshot_147_mjjyce.png">
  <meta property="og:url" content="https://asfischolar.net">
  <meta property="og:type" content="website">

  <!-- Twitter Card (For Twitter Sharing) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="ASFIMeet - Seamless Video Conferencing">
  <meta name="twitter:description" content="Experience high-quality, secure video meetings with ASFIMeet. Connect, collaborate, and stay productive.">
  <meta name="twitter:image" content="https://res.cloudinary.com/diml8ljwa/image/upload/c_thumb,w_200,g_face/v1743261283/Screenshot_147_mjjyce.png">

  <!-- Favicon -->
  <link rel="icon" href="/assets/favicon_inverted.png" type="image/x-icon">

  <!-- Canonical URL -->
  <link rel="canonical" href="https://asfischolar.net">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      display: flex;
      font-family:sans-serif;
      background-color: #222;
      font-size: 15px;
    }
    h1,h2{
      font-size: 18px;
    }
    .sidebar {
      background-color: rgba(15, 15, 15);
      color: white;
      width: 250px;
      height: 100vh;
      padding: 20px;
      position: fixed;
      left: 0;
      top: 0;
      transition: transform 0.3s ease-in-out;
    }
    .sidebar.show {
      transform: translateX(0);
    }
    .sidebar h2 {
      text-align: center;
      font-size: 15px;
    }
    .sidebar ul {
      list-style: none;
      padding: 0;
    }
    .sidebar ul li {
      margin: 20px 0;
    }
    .sidebar ul li a {
      color: #ddd;
      text-decoration: none;
      font-size: 15px;
      display: block;
      padding: 10px;
      transition: background-color 0.3s;
    }
    .sidebar ul li a:hover {
      background-color: #4b345e;
    }
    .menu-icon {
      display: none;
      font-size: 18px;
      cursor: pointer;
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 1001;
      transition: transform 0.3s ease-in-out;
    }
    .menu-icon.slide {
      transform: translateX(600%);
    }
    .main-content {
      margin-left: 270px;
      padding: 20px;
      width: 100%;
      transition: margin-left 0.3s;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .header-sub {
      margin-top: 6px;
      font-size: 13px;
      color: #b9b9c3;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 10px;
    }
    .filters label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 12px;
      color: #b9b9c3;
    }
    .filters select {
      min-width: 210px;
      padding: 9px 10px;
      border-radius: 8px;
      border: 1px solid #555;
      background-color: #262626;
      color: #f2f2f2;
      font-size: 13px;
    }
    .apply-btn {
      padding: 9px 16px;
      border: none;
      border-radius: 8px;
      background-color: purple;
      color: white;
      font-size: 13px;
      cursor: pointer;
    }
    .reset-link {
      padding: 9px 4px;
      color: #cfcfd6;
      font-size: 13px;
      text-decoration: underline;
    }

    .alert {
      margin-top: 20px;
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 14px;
    }
    .alert--error {
      background: #3b1f22;
      color: #f8b4b4;
      border: 1px solid #6b2b31;
    }

    .board {
      margin-top: 20px;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .board-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 14px;
    }
    .board-head span {
      font-size: 12px;
      color: #9aa0a6;
    }
    .poster-grid{
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead td {
      font-weight: bold;
      background: #141414;
      padding: 12px 10px;
      color: rgb(190, 190, 190);
      font-size: 13px;
      text-align: left;
      white-space: nowrap;
    }
    tbody td {
      padding: 14px 10px;
      border-bottom: 1px solid #4a4a4a;
      font-size: 14px;
      vertical-align: middle;
    }
    tbody tr:hover {
      background-color: #3a3a3a;
    }
    .poster-cell {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 220px;
    }
    .poster-title {
      font-weight: 600;
    }
    .poster-id {
      font-size: 11px;
      color: #9aa0a6;
    }
    .rank {
      font-weight: 700;
      color: #c9b3e6;
      width: 44px;
    }
    .muted {
      color: #9aa0a6;
    }
    .empty {
      text-align: center;
      color: #b9b9c3;
      padding: 28px 10px !important;
    }
    .view-poster-btn {
      display: inline-block;
      text-decoration: none;
      background-color: purple;
      color: white;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 13px;
      white-space: nowrap;
    }
    .view-poster-btn:hover {
      background-color: #6b1f8f;
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .menu-icon {
        display: block;
        font-size: 25px;
        background: purple;
        color: white;
        padding: 6px;
        border-radius: 8px;
      }
      .main-content {
        margin-left: 0;
        margin-top: 70px;
      }
      .filters select {
        min-width: 150px;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/dashboardSidebar.ejs', { sidebarRole: "admin" }) %>

  <div class="main-content">
    <header>
      <div>
        <h1>Posters Leader boards</h1>
        <p class="header-sub">
          <% if (meeting) { %>
            Top <%= boardLimit %> posters in <%= selectedMeetingName || meeting %>
          <% } else { %>
            Top <%= boardLimit %> posters across every meeting
          <% } %>
        </p>
      </div>

      <form class="filters" method="GET" action="/posteroverview">
        <label>
          Meeting
          <select name="meeting">
            <option value="">All meetings</option>
            <% meetings.forEach(function (option) { %>
              <option value="<%= option.meeting %>" <%= meeting === option.meeting ? "selected" : "" %>><%= option.name %> (<%= option.total %>)</option>
            <% }); %>
          </select>
        </label>
        <button type="submit" class="apply-btn">Apply</button>
        <% if (meeting) { %>
          <a href="/posteroverview" class="reset-link">Reset</a>
        <% } %>
      </form>
    </header>

    <% if (loadError) { %>
      <div class="alert alert--error"><%= loadError %></div>
    <% } %>

    <%
      const boardsConfig = [
        { key: "liked", title: "Most Liked Posters", metricLabel: "Likes", value: function (poster) { return Number(poster.like_count).toLocaleString(); } },
        { key: "rated", title: "Most Rated Posters", metricLabel: "Total Rating", value: function (poster) { return Number(poster.total_rating).toFixed(1) + " (" + Number(poster.rating_count).toLocaleString() + " rating" + (Number(poster.rating_count) === 1 ? "" : "s") + ")"; } },
        { key: "viewed", title: "Most Viewed Posters", metricLabel: "Views", value: function (poster) { return Number(poster.view_count).toLocaleString(); } },
        { key: "disliked", title: "Most Disliked Posters", metricLabel: "Dislikes", value: function (poster) { return Number(poster.dislike_count).toLocaleString(); } }
      ];
    %>

    <% boardsConfig.forEach(function (config) { %>
      <% const rows = Array.isArray(boards[config.key]) ? boards[config.key] : []; %>
      <section class="board">
        <div class="board-head">
          <h2><%= config.title %></h2>
          <span><%= rows.length %> poster(s)<%= meeting ? " · " + (selectedMeetingName || meeting) : "" %></span>
        </div>

        <div class="poster-grid">
          <table>
            <thead>
              <tr>
                <td>Rank</td>
                <td>Poster</td>
                <td>Presenter</td>
                <td>Meeting</td>
                <td><%= config.metricLabel %></td>
                <td>Actions</td>
              </tr>
            </thead>
            <tbody>
              <% if (rows.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty">No poster has any <%= config.metricLabel.toLowerCase() %> yet<%= meeting ? " for this meeting" : "" %>.</td>
                </tr>
              <% } %>

              <% rows.forEach(function (poster, index) { %>
                <tr>
                  <td class="rank">#<%= index + 1 %></td>
                  <td>
                    <div class="poster-cell">
                      <span class="poster-title"><%= poster.poster_deck_title %></span>
                      <span class="poster-id"><%= poster.poster_deck_id %></span>
                    </div>
                  </td>
                  <td><%= poster.poster_deck_owner %></td>
                  <td><%= poster.meeting_name || "—" %></td>
                  <td><%= config.value(poster) %></td>
                  <td>
                    <a class="view-poster-btn" href="<%= postersBase %>/event/poster/<%= encodeURIComponent(poster.poster_deck_id) %>?from_admin=true" target="_blank" rel="noopener noreferrer">View Poster</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% }); %>
  </div>

  <script>
    function toggleSidebar() {
      document.getElementById("sidebar").classList.toggle("show");
      document.getElementById("menu-icon").classList.toggle("slide");
    }
  </script>
</body>
</html>
