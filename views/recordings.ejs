<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meetings Recordings Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <!-- Favicon -->
  <link rel="icon" href="/assets/favicon_inverted.png" type="image/x-icon">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      display: flex;
      font-family:sans-serif;
      background-color: #222;
      color: #fff;
      font-size: 15px;
    }
    h1,h2{
      font-size: 18px;
    }
    /* Position comes from the shared sidebar (partials/dashboardSidebar.ejs) */
    .main-content {
      flex: 1 1 0;
      min-width: 0;
      padding: 20px;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 18px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .poster-grid{
      overflow-x: auto;
      margin-bottom: 40px;
    }
    .poster-lists {
      margin-top: 40px;
      background-color: #333;
      color: white;
      padding: 20px;
      border-radius: 18px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead td {
      font-weight: bold;
      background: #444;
      padding: 10px;
      color: rgb(190, 190, 190);
    }
    tbody td {
      padding: 20px;
      border-bottom: 1px solid #ddd;
    }
    tbody td a {
      display: flex;
      justify-content: center;
      width: 120px;
      text-decoration: none;
      background-color: purple;
      color: white;
      padding: 10px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <%- include('partials/dashboardSidebar.ejs', { sidebarRole: "admin" }) %>

  <div class="main-content">
    <header>
      <h1>Recordings Overview</h1>
      <div class="stats">
        <div>Total Recordings: <span id="total-posters">0</span></div>
      </div>
    </header>

    <!-- Poster list section -->
    <section class="poster-lists" id="poster-lists">
      <h2>Recorded Meetings</h2>
      <div class="poster-grid" id="most-rated">
        <!-- Posters will be dynamically added here -->
        <table>
          <thead>
            <td>Meeting Title</td>
            <td colspan="2">Actions</td>
          </thead>

          <tbody id="most-ratedList">
        <% if(recordings && recordings.length > 0){ for(let i=0; i<recordings.length; i++){%>
          <tr>
            <td><%=recordings[i].meeting_title %>
              <br>
             <span style="font-size: 11px;"> <%=recordings[i].time_stamp %></span>
            
            </td>
            <td>
            <a href="<%=recordings[i].file_url%>" target=_blank>Preview</a>
            </td>
            <td>
                <a href="/r/download/<%=recordings[i].meeting_title%>_<%=recordings[i].time_stamp %>?url=<%=recordings[i].file_url%>" target=_blank>Download</a>
                </td>
             </tr>
        <% }} %>
          </tbody>
         </table>
      </div>

     
    </section>
    

   
  </div>
</body>
</html>
